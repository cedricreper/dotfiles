#command = "/usr/bin/nu"
#custom-shader = ./cursor_warp.glsl
#env = XDG_CONFIG_HOME=/Users/cedric/.config

window-save-state = always

font-family="Berkeley Mono"
font-family-italic="Berkeley Mono Oblique"
font-family-bold="Berkeley Mono Bold"
font-family-bold-italic="Berkeley Mono Bold Oblique"

font-size=9

theme="Gruvbox Dark"

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

#macos-titlebar-style="hidden"
#macos-titlebar-style="tabs"
#window-decoration="auto" 

auto-update-channel = tip

window-padding-x = 5
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend
adjust-cell-height = 0
mouse-hide-while-typing = true
scrollback-limit = 1000000

#background-blur = macos-glass-clear
#background-opacity = 0.9

notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
notify-on-command-finish-action = no-bell,notify

# keybindings
#keybind = ctrl+space>t=new_tab

#keybind = ctrl+space>s=new_split:down
#keybind = ctrl+space>v=new_split:right
#unfocused-split-opacity=0.5

#keybind = ctrl+h=goto_split:left
#keybind = ctrl+j=goto_split:bottom
#keybind = ctrl+k=goto_split:top
#keybind = ctrl+l=goto_split:right

#keybind = ctrl+space>n=next_tab
#keybind = ctrl+space>p=previous_tab

#keybind = ctrl+space>1=goto_tab:1
#keybind = ctrl+space>2=goto_tab:2
#keybind = ctrl+space>3=goto_tab:3
#keybind = ctrl+space>4=goto_tab:4
#keybind = ctrl+space>5=goto_tab:5
#keybind = ctrl+space>6=goto_tab:6
#keybind = ctrl+space>7=goto_tab:7
#keybind = ctrl+space>8=goto_tab:8
#keybind = ctrl+space>9=goto_tab:9

# Ignore annoying keybind
#keybind = super+n=ignore
#keybind = super+t=ignore
